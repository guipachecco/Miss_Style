# Copie para .env.local. O Project ID do Sanity é público; tokens e senhas NUNCA entram aqui no Git.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ID do site no Umami Cloud (público). Sem ele, nenhuma medição é carregada.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# 1 libera o Google; sem isso o site fica oculto das buscas (modo teste).
NEXT_PUBLIC_INDEXAR=
